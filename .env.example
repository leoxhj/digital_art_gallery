# Set DATABASE_URL to use a single connection string, or configure the PG* fields below.
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/digital_art_gallery
PGHOST=localhost
PGDATABASE=digital_art_gallery
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_password
PORT=5001
AUTHOR_BIRTHDAY=2017-09-04
ARTWORK_AUTHOR=Rachel Xu
WATERMARK_OPACITY=0.28
WATERMARK_FONT_SIZE=16px
# Example values only; generate fresh private tokens for production deployments.
AUTH_SECRET=your_strong_random_secret_here
AUTH_SETUP_TOKEN=your_strong_random_setup_token_here
AUTH_SESSION_TTL_SECONDS=43200
# Local HTTP only. Set true when serving over HTTPS.
AUTH_COOKIE_SECURE=false
